{
  "manifest_version": 3,
  "name": "Neele-Vat BluJay Assistent",
  "version": "2.0.0",
  "description": "Voert vaste handelingen automatisch uit in BluJay, op basis van je invoer.",
  "permissions": [
    "storage",
    "webNavigation",
    "tabs",
    "scripting",
    "sidePanel",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Neele-Vat BluJay Assistent (Alt+B)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": [
        "src/shared.js",
        "src/content.js"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+B"
      },
      "description": "Open Neele-Vat BluJay Assistent"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "src/popup/popup.html"
  }
}
